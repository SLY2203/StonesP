# Environment Configuration for MSU DCS Alumni Tracking System

# Set to 'True' for local development, 'False' in production
DEBUG=True

# Secret Key (generate a secure random string for production)
SECRET_KEY=django-insecure-msu-dcs-alumni-tracking-system-key-2026

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2,0.0.0.0

# Database Engine: 'postgres', 'mysql', or 'sqlite' (defaults to sqlite fallback)
DB_ENGINE=postgres

# Database Settings
DB_NAME=stones
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# SimpleJWT token lifetimes (minutes)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Firebase Cloud Messaging Server Key (Optional for production push notifications)
FCM_SERVER_KEY=
